% dcases = [2:2:10]';
dcases = [1:2:9]';

tic;
%% Compute when multiple pre-computed files (Cylindrical Buoyancy)
wkb_basis_dir = 'C:\Users\yhkuo\Documents\MATLAB\MATCHING_STEP_BASIS\D_H\';
wkb_basis_fn = 'PRECOMPUTED_VERTICAL_MODES_DHStepBASIS_0-20KM.mat';

% For anelastic basis
load([wkb_basis_dir wkb_basis_fn]) % ADX(z,ky,kx,DH)
Z = Z*1e3; % km-->m
% d = 1; % km; horizontal diameter of buoyancy
x = [-Lx/2:Lx/Nx:Lx/2-Lx/Nx];
y = [-Ly/2:Ly/Ny:Ly/2-Ly/Ny]';
[X,Y] = meshgrid(x,y);
% Horizontal buoyancy configuration
sig = Lx/Nx; % km; transition in ~3*sig; 45/128~0.35
R = sqrt(X.^2 + Y.^2);
[fft2Kx,fft2Ky] = meshgrid((2*pi/Lx)*[0:Nx/2-1 Nx/2 -Nx/2+1:-1],...
                           (2*pi/Ly)*[0:Ny/2-1 Ny/2 -Ny/2+1:-1]); % (ky,kx)

% PMB = nan(size(ADX,1),size(ADX,4),length(dcases)+1,length(dcases)+1); 
PMD = nan(size(ADX,1),size(ADX,4),length(dcases)+1,length(dcases)+1); 

checkerboard = 1;%mod(round(X+1),2).*mod(round(Y+1),2);

id = 1;
d = dcases(id);
disp(num2str(d))

DH = double(R<=d/2);%erfc((R-d/2)/sig)/2; % max(BH) = 1 (SI units)
DH = DH.*checkerboard;
DH = DH./mean(DH(R<=d/2));
DH(:,x<0) = -DH(:,x<0); % Flip w.r.t. x=0 for symmetry
fft2DH = 1i*fft2(DH);
for idz=1:size(ADX,4)
  ADH = real(ifft2(permute(ADX(:,:,:,idz),[2,3,1]).*fft2DH));
  ADH = reshape(ADH,[],size(ADX,1));
  PMD(:,idz,id,1) = squeeze(mean(ADH(R<=dcases(1)/2,:))); % Mass-flux Basis = PMB(Z,Bi)*rho_0(Z)
  for od=2:length(dcases)
    PMD(:,idz,id,od) = squeeze(mean(ADH(R>dcases(od-1)/2&R<=dcases(od)/2,:)));
  end
  PMD(:,idz,id,end) = squeeze(mean(ADH(R>dcases(end)/2,:)));
end
clear DH fft2DH ADH

for id=2:length(dcases)
  di = dcases(id-1);
  do = dcases(id);
  disp(num2str(do))

  DH = double(R<=do/2)-double(R<=di/2);%erfc((R-do/2)/sig)/2 - erfc((R-di/2)/sig)/2;
  DH = DH.*checkerboard;
  DH = DH./mean(DH(R<=do/2&R>di/2));
  DH(:,x<0) = -DH(:,x<0); % Flip w.r.t. x=0 for symmetry
  fft2DH = 1i*fft2(DH);
  for idz=1:size(ADX,4)
    ADH = real(ifft2(permute(ADX(:,:,:,idz),[2,3,1]).*fft2DH));
    ADH = reshape(ADH,[],size(ADX,1));
    PMD(:,idz,id,1) = squeeze(mean(ADH(R<=dcases(1)/2,:)));
    for od=2:length(dcases)
      PMD(:,idz,id,od) = squeeze(mean(ADH(R>dcases(od-1)/2&R<=dcases(od)/2,:)));
    end
    PMD(:,idz,id,end) = squeeze(mean(ADH(R>dcases(end)/2,:)));
  end
  clear DH fft2DH ADH 
end


id = length(dcases)+1;
disp(['>' num2str(dcases(end))])

DH = 1-double(R<=dcases(end)/2);%1 - erfc((R-dcases(end)/2)/sig)/2;
DH = DH.*checkerboard;
DH = DH./mean(DH(R>dcases(end)/2));
DH(:,x<0) = -DH(:,x<0); % Flip w.r.t. x=0 for symmetry
fft2DH = 1i*fft2(DH);
for idz=1:size(ADX,4)
  ADH = real(ifft2(permute(ADX(:,:,:,idz),[2,3,1]).*fft2DH));
  ADH = reshape(ADH,[],size(ADX,1));
  PMD(:,idz,id,1) = squeeze(mean(ADH(R<=dcases(1)/2,:)));
  for od=2:length(dcases)
    PMD(:,idz,id,od) = squeeze(mean(ADH(R>dcases(od-1)/2&R<=dcases(od)/2,:)));
  end
  PMD(:,idz,id,end) = squeeze(mean(ADH(R>dcases(end)/2,:)));
end
clear DH fft2DH ADH

save([wkb_basis_dir 'COMPOSITE_ACE_BASIS_DH_0-20KM.mat'],"PMD","dcases","Z","sig","Lx","Ly","Nx","Ny",'-v7.3')
pmb = PMD;
pmd = PMD;
zl = zL;
zh = zH;

%%
wkb_basis_dir = 'C:\Users\yhkuo\Documents\MATLAB\MATCHING_STEP_BASIS\D_H\';
wkb_basis_fn = 'PRECOMPUTED_VERTICAL_MODES_DHStepBASIS_20-40KM.mat';

% For anelastic basis
load([wkb_basis_dir wkb_basis_fn])
Z = Z*1e3; % km-->m
% d = 1; % km; horizontal diameter of buoyancy
x = [-Lx/2:Lx/Nx:Lx/2-Lx/Nx];
y = [-Ly/2:Ly/Ny:Ly/2-Ly/Ny]';
[X,Y] = meshgrid(x,y);
% Horizontal buoyancy configuration
sig = Lx/Nx; % km; transition in ~3*sig; 45/128~0.35
R = sqrt(X.^2 + Y.^2);
[fft2Kx,fft2Ky] = meshgrid((2*pi/Lx)*[0:Nx/2-1 Nx/2 -Nx/2+1:-1],...
                           (2*pi/Ly)*[0:Ny/2-1 Ny/2 -Ny/2+1:-1]); % (ky,kx)

% PMB = nan(size(ADX,1),size(ADX,4),length(dcases)+1,length(dcases)+1); 
PMD = nan(size(ADX,1),size(ADX,4),length(dcases)+1,length(dcases)+1); 

id = 1;
d = dcases(id);
disp(num2str(d))

DH = double(R<=d/2);%erfc((R-d/2)/sig)/2; % max(BH) = 1 (SI units)
DH = DH.*checkerboard;
DH = DH./mean(DH(R<=d/2));
DH(:,x<0) = -DH(:,x<0); % Flip w.r.t. x=0 for symmetry
fft2DH = 1i*fft2(DH);
for idz=1:size(ADX,4)
  ADH = real(ifft2(permute(ADX(:,:,:,idz),[2,3,1]).*fft2DH));
  ADH = reshape(ADH,[],size(ADX,1));
  PMD(:,idz,id,1) = squeeze(mean(ADH(R<=dcases(1)/2,:))); % Mass-flux Basis = PMB(Z,Bi)*rho_0(Z)
  for od=2:length(dcases)
    PMD(:,idz,id,od) = squeeze(mean(ADH(R>dcases(od-1)/2&R<=dcases(od)/2,:)));
  end
  PMD(:,idz,id,end) = squeeze(mean(ADH(R>dcases(end)/2,:)));
end
clear DH fft2DH ADH

for id=2:length(dcases)
  di = dcases(id-1);
  do = dcases(id);
  disp(num2str(do))

  DH = double(R<=do/2)-double(R<=di/2);%erfc((R-do/2)/sig)/2 - erfc((R-di/2)/sig)/2;
  DH = DH.*checkerboard;
  DH = DH./mean(DH(R<=do/2&R>di/2));
  DH(:,x<0) = -DH(:,x<0); % Flip w.r.t. x=0 for symmetry
  fft2DH = 1i*fft2(DH);
  for idz=1:size(ADX,4)
    ADH = real(ifft2(permute(ADX(:,:,:,idz),[2,3,1]).*fft2DH));
    ADH = reshape(ADH,[],size(ADX,1));
    PMD(:,idz,id,1) = squeeze(mean(ADH(R<=dcases(1)/2,:)));
    for od=2:length(dcases)
      PMD(:,idz,id,od) = squeeze(mean(ADH(R>dcases(od-1)/2&R<=dcases(od)/2,:)));
    end
    PMD(:,idz,id,end) = squeeze(mean(ADH(R>dcases(end)/2,:)));
  end
  clear DH fft2DH ADH
end


id = length(dcases)+1;
disp(['>' num2str(dcases(end))])

DH = 1-double(R<=dcases(end)/2);%1 - erfc((R-dcases(end)/2)/sig)/2;
DH = DH.*checkerboard;
DH = DH./mean(DH(R>dcases(end)/2));
DH(:,x<0) = -DH(:,x<0); % Flip w.r.t. x=0 for symmetry
fft2DH = 1i*fft2(DH);
for idz=1:size(ADX,4)
  ADH = real(ifft2(permute(ADX(:,:,:,idz),[2,3,1]).*fft2DH));
  ADH = reshape(ADH,[],size(ADX,1));
  PMD(:,idz,id,1) = squeeze(mean(ADH(R<=dcases(1)/2,:)));
  for od=2:length(dcases)
    PMD(:,idz,id,od) = squeeze(mean(ADH(R>dcases(od-1)/2&R<=dcases(od)/2,:)));
  end
  PMD(:,idz,id,end) = squeeze(mean(ADH(R>dcases(end)/2,:)));
end
clear DH fft2DH ADH

save([wkb_basis_dir 'COMPOSITE_ACE_BASIS_DH_20-40KM.mat'],"PMD","dcases","Z","sig","Lx","Ly","Nx","Ny",'-v7.3')

%% Collect
PMD = [pmb, PMD];
PMD = [pmd, PMD];
zL = [zl;zL];
zH = [zh;zH];
save([wkb_basis_dir 'COMPOSITE_ACE_BASIS_KKNW25_' num2str(length(dcases)+1) 'ACEs_DH.mat'],"PMD","dcases","Z","zL","zH","sig","Lx","Ly","Nx","Ny",'-v7.3')

toc %~20min